{
  "name": "platform-pemiltang-steik26",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend pemilihan GENESIS STEI-K '26 (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create pemiltang",
    "db:migrate": "wrangler d1 migrations apply pemiltang --remote",
    "db:migrate:local": "wrangler d1 migrations apply pemiltang --local",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "test": "node tests/alur.mjs",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
